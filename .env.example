# Server Configuration
PORT=3000
NODE_ENV=development

# Vercel Blob Storage
# Get your token from: https://vercel.com/docs/storage/vercel-blob/quickstart
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token_here

# Payload CMS
PAYLOAD_API_URL=http://localhost:3001/api

# Database (for Payload CMS)
DATABASE_URL=postgresql://user:password@localhost:5432/catchmaster

# Authentication
# TODO: Add Firebase or Supabase auth configuration
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_PROJECT_ID=
# Or for Supabase:
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
