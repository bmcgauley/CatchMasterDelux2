{
  "name": "catchmaster-delux",
  "version": "1.0.0",
  "description": "CatchMaster Delux - A Pokemon-inspired game",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "server": "nodemon app.js",
    "client": "cd client && npm start",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "dev:payload": "cd payload && npx payload dev",
    "dev:client": "cd client && npm run dev",
    "build": "cd client && npm run build"
  },
  "dependencies": {
    "@vercel/blob": "^0.24.1",
    "axios": "^0.21.1",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.6",
    "express": "^4.17.1",
    "lucide-react": "^0.452.0",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0"
  },
  "devDependencies": {
    "concurrently": "^6.2.0",
    "nodemon": "^2.0.15"
  }
}
