# Migration Configuration
# Copy to .env.migration and adjust for your environment

# Active window for user data migration (in months)
# Only migrate users who have been active within this window
# Default: 12 months
MIGRATION_ACTIVE_WINDOW_MONTHS=12

# Batch size for migration operations
# Number of records to process in a single batch
# Default: 50
MIGRATION_BATCH_SIZE=50

# Dry run mode - when true, no actual changes are made
# Set to false to perform actual migration
# Default: true (safe mode)
DRY_RUN=true

# Retry configuration
# Maximum number of retry attempts for failed operations
MAX_RETRY_ATTEMPTS=3

# Logging level for migration operations
# Options: debug, info, warn, error
LOG_LEVEL=info
